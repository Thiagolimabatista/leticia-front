# ─── Para onde vão as mensagens do formulário ───────────────────────────────
# Se não preencher, o padrão já é lilaabrand@gmail.com (lib/site-config.ts).
CONTACT_TO_EMAIL=lilaabrand@gmail.com

# Remetente que aparece na caixa de entrada.
# Com Resend sem domínio próprio, deixe em branco (usa onboarding@resend.dev).
CONTACT_FROM_EMAIL=

# ─── Opção A: Resend (mais simples) ─────────────────────────────────────────
# Crie a chave em https://resend.com/api-keys e cole aqui.
RESEND_API_KEY=

# ─── Opção B: SMTP do Gmail (usado só se RESEND_API_KEY estiver vazio) ──────
# Gere uma "Senha de app" em https://myaccount.google.com/apppasswords
# (a senha normal do Gmail não funciona).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=lilaabrand@gmail.com
SMTP_PASS=
